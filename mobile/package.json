{
  "name": "blackwall-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --clean",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.ts",
    "doctor": "expo-doctor",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "expo": "58.0.22",
    "expo-constants": "58.0.14",
    "expo-file-system": "58.0.13",
    "expo-intent-launcher": "58.0.3",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.12",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "expo-doctor": "1.21.5",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1",
    "@isaacs/nonrecursive-glob-match": "1.0.3"
  }
}
