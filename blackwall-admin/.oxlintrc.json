{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/only-export-components": "off"
  },
  "overrides": [
    {
      "files": [
        "src/features/home/**",
        "src/features/work/**",
        "src/features/analytics/**",
        "src/features/journal/**",
        "src/features/settings/**"
      ],
      "rules": {
        "react/purity": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist",
    "desktop/out",
    "release"
  ]
}
