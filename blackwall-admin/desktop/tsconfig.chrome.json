{
  // The chrome UI page (browser renderer, no Node). Emits to out/.
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.desktop-chrome.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "rootDir": "src",
    "outDir": "out",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/chrome", "src/shared"]
}
