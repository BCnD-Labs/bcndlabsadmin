{
  "name": "blackwall-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -b desktop",
    "lint": "oxlint",
    "check": "npm run typecheck && oxlint && vite build",
    "preview": "vite preview",
    "desktop:ui": "vite build --config vite.mac.config.ts",
    "desktop:compile": "npm run typecheck && npm run desktop:ui && node desktop/scripts/copy-static.ts",
    "desktop:dev": "npm run desktop:compile && electron desktop",
    "desktop:build": "npm run desktop:compile && node desktop/scripts/build.ts",
    "desktop:test": "node --test desktop/tests/*.test.ts",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@material-symbols/svg-400": "0.48.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/nodemailer": "8.0.2",
    "bootstrap": "5.3.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "docx-preview": "^0.4.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.64.0",
    "marked": "18.1.1",
    "nodemailer": "10.1.7",
    "pg": "^8.23.1",
    "pptx-viewer": "^0.2.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.15.0",
    "react-router-dom": "^7.18.5",
    "read-excel-file": "^9.3.15",
    "recharts": "^3.8.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.10.1",
    "electron-builder": "26.18.0",
