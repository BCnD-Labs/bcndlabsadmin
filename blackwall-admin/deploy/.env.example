# Copy these into the Portainer stack's environment variables (or a .env next to
# docker-compose.yml). Generate values on any machine with Node 24 in blackwall-admin/:
#   node server/cli.ts gen-key          → BLACKWALL_SECRET_KEY
#   node server/cli.ts hash-password    → BLACKWALL_PASSWORD_HASH
#   openssl rand -hex 24                → POSTGRES_PASSWORD, BACKUP_PASSPHRASE (hex, not base64:
#                                         the password goes inside DATABASE_URL)
#
# Save BLACKWALL_SECRET_KEY and BACKUP_PASSPHRASE in your password manager.
# Without them, backups can't be restored and stored tokens can't be decrypted.

POSTGRES_PASSWORD=
BLACKWALL_SECRET_KEY=
BLACKWALL_PASSWORD_HASH=

# Your server's Tailscale name as you'll type it in the browser (from `tailscale serve`).
BLACKWALL_ALLOWED_HOSTS=homelab.your-tailnet.ts.net
BLACKWALL_PORT=8780

# Local backups on the server (absolute host path; created if missing).
BACKUP_DIR_HOST=/opt/blackwall/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
# Encrypts every dump (AES-256). Required for off-site uploads.
BACKUP_PASSPHRASE=

# --- Off-site copy (optional) -------------------------------------------------
# Destination as remote:path. Leave empty to keep backups on the server only.
BACKUP_OFFSITE=
BACKUP_OFFSITE_KEEP_DAYS=60

# Cloudflare R2 (S3-compatible; free tier is plenty):
#   BACKUP_OFFSITE=offsite:blackwall-backups
#   OFFSITE_TYPE=s3
#   OFFSITE_PROVIDER=Cloudflare
#   OFFSITE_ACCESS_KEY_ID=...
#   OFFSITE_SECRET_ACCESS_KEY=...
#   OFFSITE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#
# Azure Blob Storage (e.g. Azure for Students credit):
#   BACKUP_OFFSITE=offsite:blackwall-backups
#   OFFSITE_TYPE=azureblob
#   OFFSITE_ACCOUNT=<storage account name>
#   OFFSITE_KEY=<access key>
OFFSITE_TYPE=
OFFSITE_PROVIDER=
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=
OFFSITE_ENDPOINT=
OFFSITE_ACCOUNT=
OFFSITE_KEY=
